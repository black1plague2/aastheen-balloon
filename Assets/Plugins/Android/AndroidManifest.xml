<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          xmlns:horizonos="http://schemas.horizonos/sdk"
          android:installLocation="auto">

  <!-- ── Network (kept for optional WiFi sync) ───────────────────── -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

  <!-- ── Bluetooth BLE (Quest 3S = Android 12) ────────────────────── -->
  <uses-permission android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
      android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

  <!-- ── Hand Tracking ────────────────────────────────────────────── -->
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
  <uses-feature android:name="oculus.software.handtracking" android:required="true" />

  <!-- ── VR head tracking (required for all Quest apps) ───────────── -->
  <uses-feature android:name="android.hardware.vr.headtracking"
                android:version="1"
                android:required="true" />

  <!-- ── Controllers NOT required ─────────────────────────────────── -->
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />

  <!-- ── Application ──────────────────────────────────────────────── -->
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/app_icon"
      android:allowBackup="false">

    <activity
        android:name="com.unity3d.player.UnityPlayerGameActivity"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:launchMode="singleTask"
        android:exported="true"
        android:excludeFromRecents="true"
        android:configChanges="locale|fontScale|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>

      <!-- Required for proper VR focus handling -->
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    </activity>

    <!-- Unity -->
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="false" />

    <!-- Meta splash -->
    <meta-data android:name="com.oculus.ossplash.background" android:value="black" />

    <!-- Telemetry GUID (keep your existing value) -->
    <meta-data android:name="com.oculus.telemetry.project_guid"
               android:value="900d92fd-3213-40aa-8269-d93812fd8a6f" />

    <!-- Target Quest devices — quest3s is the primary target -->
    <meta-data android:name="com.oculus.supportedDevices"
               android:value="quest|quest2|questpro|quest3|quest3s"
               tools:replace="android:value" />

    <!-- Hand tracking V2 (skeleton + high fidelity pinch/pose) -->
    <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />

    <!-- HIGH = 30 Hz hand tracking updates; use LOW for battery saving -->
    <meta-data android:name="com.oculus.handtracking.frequency" android:value="HIGH" />

  </application>

  <!-- Horizon OS SDK version range -->
  <horizonos:uses-horizonos-sdk
      horizonos:minSdkVersion="60"
      horizonos:targetSdkVersion="201" />

</manifest>
